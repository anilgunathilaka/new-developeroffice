{{! SECTION 01 — HERO }}
<section class="hero" id="top">
  <div class="hero-stage">
    <video class="hero-video is-on" id="heroVideo" muted loop playsinline autoplay preload="auto" aria-hidden="true">
      <source src="{{asset '/videos/hero-video.mp4'}}" type="video/mp4">
    </video>
    <canvas class="hero-canvas" id="heroCanvas" aria-hidden="true"></canvas>
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-inner">
      <h1>
        <span class="ln"><span>We build</span> <span class="hero-shape" id="heroShape"><span class="hero-shape-text">software</span><canvas class="hero-shape-canvas" aria-hidden="true"></canvas></span></span>
        <span class="ln">that matters.</span>
      </h1>
      <div class="hero-cta">
        {{> button href="/work" label="Explore Our Work" variant="btn-primary"}}
        {{> button href="/contact/start-a-project" label="Start a Project" variant="btn-ghost" arrow=true}}
      </div>
    </div>
    <div class="hero-projects">
      <p class="hero-projects-label">Selected work</p>
      <div class="hero-projects-mask">
        <div class="hero-projects-track">
          <ul>
            {{#each projects}}<li><a href="/work/{{slug}}">{{name}}</a></li>{{/each}}
          </ul>
          <ul aria-hidden="true">
            {{#each projects}}<li><a href="/work/{{slug}}">{{name}}</a></li>{{/each}}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{{! SECTION 02 — OPENING STATEMENT }}
<section class="opening" id="opening">
  <div class="opening-pin">
  <div class="jt-wrap">
    <h2 class="opening-h">Complex problems deserve<br>serious engineering.</h2>
  </div>
  <p class="opening-watermark" aria-hidden="true">DEVELOPER OFFICE</p>
  <ul class="opening-line">
    <li>
      <div class="opening-viz">
        <img src="{{asset '/images/Software-engineering.webp'}}" alt="" width="800" height="800" loading="lazy">
      </div>
      <div class="opening-meta">
        <span class="opening-mark" aria-hidden="true">SE</span>
        <div>
          <span>Software engineering</span>
          <small>Developer Office</small>
        </div>
      </div>
    </li>
    <li>
      <div class="opening-viz">
        <img src="{{asset '/images/Artificial-intelligence.webp'}}" alt="" width="800" height="800" loading="lazy">
      </div>
      <div class="opening-meta">
        <span class="opening-mark" aria-hidden="true">AI</span>
        <div>
          <span>Artificial intelligence</span>
          <small>Developer Office</small>
        </div>
      </div>
    </li>
    <li>
      <div class="opening-viz">
        <img src="{{asset '/images/Applied-research.webp'}}" alt="" width="800" height="800" loading="lazy">
      </div>
      <div class="opening-meta">
        <span class="opening-mark" aria-hidden="true">AR</span>
        <div>
          <span>Applied research</span>
          <small>Developer Office</small>
        </div>
      </div>
    </li>
    <li>
      <div class="opening-viz">
        <img src="{{asset '/images/Product-development.webp'}}" alt="" width="800" height="800" loading="lazy">
      </div>
      <div class="opening-meta">
        <span class="opening-mark" aria-hidden="true">PD</span>
        <div>
          <span>Product development</span>
          <small>Developer Office</small>
        </div>
      </div>
    </li>
  </ul>
  </div>
</section>

{{! SECTION 03 — PROOF }}
<section class="proof" id="proof">
  <div class="jt-wrap proof-head">
    <h2>Why teams trust us</h2>
  </div>
  <div class="proof-pin">
    <div class="stats">
      {{#each stats}}
      <div class="stat{{#if image}} has-bg{{/if}}">
        {{#if image}}<img class="stat-bg" src="{{asset image}}" alt="" width="1600" height="900" aria-hidden="true">{{/if}}
        <div class="lab">{{label}}</div>
        <div class="num {{#unless countTo}}txt{{/unless}}">
          {{#if countTo}}<span class="count" data-to="{{countTo}}">0</span>{{else}}{{value}}{{/if}}<span class="u">{{unit}}</span>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>

{{! SECTION 04 — SELECTED WORK }}
<section class="work" id="work">
  <div class="jt-wrap">
    <div class="work-intro">
      <h2>The proof is the projects.</h2>
    </div>
  </div>
  <div class="work-marquee">
    <div class="work-marquee-track">
      <div class="work-cards">
        {{#each featured}}
        <a href="/work/{{slug}}" class="work-card work-card--{{theme}}">
          <div class="work-card-inner">
            <span class="work-card-view" aria-hidden="true">
              <svg width="19" height="19" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div class="work-card-preview" aria-hidden="true">
              {{#if image}}
              <img src="{{asset image}}" alt="" width="640" height="640" loading="lazy">
              {{else}}
              <span>{{tag}}</span>
              {{/if}}
            </div>
            <div class="work-card-foot">
              <h3>{{name}}</h3>
              <span class="work-card-label">{{tag}}</span>
            </div>
          </div>
        </a>
        {{/each}}
      </div>
      <div class="work-cards" aria-hidden="true">
        {{#each featured}}
        <a href="/work/{{slug}}" class="work-card work-card--{{theme}}" tabindex="-1">
          <div class="work-card-inner">
            <span class="work-card-view">
              <svg width="19" height="19" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div class="work-card-preview">
              {{#if image}}
              <img src="{{asset image}}" alt="" width="640" height="640" loading="lazy">
              {{else}}
              <span>{{tag}}</span>
              {{/if}}
            </div>
            <div class="work-card-foot">
              <h3>{{name}}</h3>
              <span class="work-card-label">{{tag}}</span>
            </div>
          </div>
        </a>
        {{/each}}
      </div>
    </div>
  </div>
  <div class="jt-wrap">
    <div class="work-all">
      <a href="/work" class="work-all-btn">
        <span class="btn-inner">View all work
          <span class="work-all-arw" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </span>
      </a>
    </div>
  </div>
</section>

{{! SECTION 05 — BUILT FOR REALITY }}
<section class="reality">
  <div class="jt-wrap">
    <div class="reality-head rv">
      <h2>Built for the systems<br>people actually use.</h2>
    </div>
    <ul class="institutions">
      <li class="rv">
        <div class="inst-top">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 20h16M6 20V10l6-4 6 4v10M10 20v-5h4v5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <h3>Courts &amp; legal</h3>
        </div>
      </li>
      <li class="rv">
        <div class="inst-top">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16v10H4zM8 7V5h8v2M4 12h16" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <h3>Banks &amp; finance</h3>
        </div>
      </li>
      <li class="rv">
        <div class="inst-top">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 20V8l7-4 7 4v12M9 20v-6h6v6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <h3>Government registries</h3>
        </div>
      </li>
      <li class="rv">
        <div class="inst-top">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <h3>Newsrooms</h3>
        </div>
      </li>
      <li class="rv">
        <div class="inst-top">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 20V6h12v14M9 6V4h6v2M9 11h6M9 15h6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <h3>National archives</h3>
        </div>
      </li>
      <li class="rv inst-cta">
        <a href="/work">
          <div class="inst-top">
            <span class="inst-cta-arw" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <h3>See who we build for</h3>
          </div>
        </a>
      </li>
    </ul>
  </div>
</section>

{{! SECTION 06 — AI }}
<section class="ai" id="ai">
  <div class="jt-wrap">
    <h2 class="rv">Intelligence, engineered.</h2>
  </div>
  <div class="ai-slider">
    <div class="ai-viewport" id="aiSlider" tabindex="0" role="region" aria-roledescription="carousel" aria-label="Applied AI">
      <div class="strand">
        <div class="strand-viz">
          <img src="{{asset '/images/Intelligence-1.webp'}}" alt="" width="1600" height="1000" loading="lazy" draggable="false">
        </div>
        <div class="strand-copy">
          <span class="tag">Language AI</span>
          <p>Sinhala &amp; Tamil OCR at 97%, built on models trained for scripts the large labs ignore.</p>
        </div>
      </div>
      <div class="strand">
        <div class="strand-viz">
          <img src="{{asset '/images/Intelligence-2.webp'}}" alt="" width="1600" height="1000" loading="lazy" draggable="false">
        </div>
        <div class="strand-copy">
          <span class="tag">Legal intelligence</span>
          <p>AskLex.law: retrieval-grade AI for Sri Lankan law, with checkable citations.</p>
        </div>
      </div>
      <div class="strand">
        <div class="strand-viz">
          <img src="{{asset '/images/Intelligence-3.webp'}}" alt="" width="1600" height="1000" loading="lazy" draggable="false">
        </div>
        <div class="strand-copy">
          <span class="tag">Financial platforms</span>
          <p>Deterministic, auditable engineering for high-volume financial workflows.</p>
        </div>
      </div>
      <div class="strand">
        <div class="strand-viz">
          <img src="{{asset '/images/Intelligence-4.webp'}}" alt="" width="1600" height="1000" loading="lazy" draggable="false">
        </div>
        <div class="strand-copy">
          <span class="tag">AI agents</span>
          <p>Systems that research, draft and monitor, with permissioned access and configurable workflows.</p>
        </div>
      </div>
    </div>
    <div class="ai-bar">
      <a href="/capabilities/ai-engineering" class="work-all-btn">
        <span class="btn-inner">How we think about AI
          <span class="work-all-arw" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </span>
      </a>
      <div class="ai-nav" id="aiNav">
        <button class="ai-nav-btn" id="aiPrev" type="button" aria-label="Go to previous slide">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 4.5L7 10l5.5 5.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="ai-nav-btn" id="aiNext" type="button" aria-label="Go to next slide">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 4.5L13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
    <div class="ai-dots" id="aiDots" hidden></div>
  </div>
</section>

{{! SECTION 07 — METHOD }}
<section class="method" id="method">
  <div class="method-pin">
    <div class="jt-wrap">
      <h2>Five stages, from first question<br>to running system.</h2>
    </div>
    <p class="method-watermark" aria-hidden="true">DEVELOPER OFFICE</p>
    <div class="steps" id="steps">
      <a href="/studio/approach#understand" class="step"><span class="step-view" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="n">01</span><h3>Understand</h3><p>The organisation, users, constraints, and problem.</p></a>
      <a href="/capabilities/applied-research" class="step"><span class="step-view" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="n">02</span><h3>Model</h3><p>Research first, define the approach, then build.</p></a>
      <a href="/capabilities/product-engineering" class="step"><span class="step-view" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="n">03</span><h3>Build</h3><p>Design and engineer the system.</p></a>
      <a href="/studio/approach#validate" class="step"><span class="step-view" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="n">04</span><h3>Validate</h3><p>Test against real-world needs, not demos.</p></a>
      <a href="/capabilities/enterprise-systems" class="step"><span class="step-view" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="n">05</span><h3>Operate</h3><p>Deploy, measure, improve and maintain.</p></a>
    </div>
    <div class="jt-wrap">
      <div class="work-all method-cta">
        <a href="/studio/approach" class="work-all-btn">
          <span class="btn-inner">Our approach in detail
            <span class="work-all-arw" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

{{! SECTION 08 — INSIGHTS }}
<section class="insights-teaser">
  <div class="jt-wrap">
    <h2 class="rv">We publish what we learn.</h2>
    <div class="art-grid">
      {{#each insights}}{{> article-card this}}{{/each}}
    </div>
    <div class="work-all">
      <a href="/insights" class="work-all-btn">
        <span class="btn-inner">Read the Insights
          <span class="work-all-arw" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </span>
      </a>
    </div>
  </div>
</section>

{{! SECTION 09 — CLOSING }}
<section class="closing">
  <div class="jt-wrap">
    <div class="closing-panel rv">
      <p class="jt-kicker">Let's work</p>
      <h2>Have a difficult&nbsp;problem?<br><span class="l2">Let's figure out what to build.</span></h2>
      <div class="closing-cta">
        {{> button href="/contact/start-a-project" label="Start a Project" arrow=true}}
        <a href="mailto:hello@developeroffice.com" class="closing-alt">Talk with an engineer</a>
      </div>
      <div class="closing-contact">
        <a href="mailto:hello@developeroffice.com">hello@developeroffice.com</a>
        <a href="tel:+94777552555">+94 77 755 2555</a>
        <span>Nugegoda, Colombo</span>
      </div>
    </div>
  </div>
</section>
