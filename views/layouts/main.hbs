<!DOCTYPE html>
<html lang="en">
<head>
  {{> seo-head}}
  <link rel="icon" type="image/png" sizes="128x128" href="{{asset '/images/favicon.png'}}">
  <link rel="apple-touch-icon" href="{{asset '/images/favicon.png'}}">
  <link rel="stylesheet" href="{{asset '/css/tokens.css'}}">
  <link rel="stylesheet" href="{{asset '/css/main.css'}}">
  {{#if meta.pageCss}}<link rel="stylesheet" href="{{asset (concat '/css/pages/' meta.pageCss '.css')}}">{{/if}}
</head>
<body{{#if (eq meta.pageCss 'home')}} class="has-dark-hero"{{/if}}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="header" id="header">
    <a href="/" class="brand">{{> logo}}</a>
    <nav class="nav" aria-label="Primary">
      <ul class="nav-links">
        <li><a href="/work" {{#if (eq meta.nav 'work')}}aria-current="page"{{/if}}>Work</a></li>
        <li><a href="/capabilities" {{#if (eq meta.nav 'capabilities')}}aria-current="page"{{/if}}>Capabilities</a></li>
        <li><a href="/studio" {{#if (eq meta.nav 'studio')}}aria-current="page"{{/if}}>Studio</a></li>
        <li><a href="/insights" {{#if (eq meta.nav 'insights')}}aria-current="page"{{/if}}>Insights</a></li>
      </ul>
    </nav>
    <div class="nav-end">
      {{> button href="/contact/start-a-project" label="Start a Project" variant="btn-header" arrow=true}}
      <button class="menu-toggle" id="menuToggle" type="button" aria-expanded="false" aria-controls="mobileMenu" aria-label="Open menu">
        <span class="menu-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </header>
  {{> mobile-menu}}
  <main id="main">
    {{{body}}}
  </main>
  {{> footer}}
  {{> action-bar}}
  <script defer src="{{asset '/js/header.js'}}"></script>
  <script defer src="{{asset '/js/reveal.js'}}"></script>
  <script defer src="{{asset '/js/count.js'}}"></script>
  <script defer src="{{asset '/js/method.js'}}"></script>
  {{#if (eq meta.pageCss 'home')}}<script defer src="{{asset '/js/opening.js'}}"></script>{{/if}}
  {{#if (eq meta.pageCss 'home')}}<script defer src="{{asset '/js/work-facts.js'}}"></script>{{/if}}
</body>
</html>
