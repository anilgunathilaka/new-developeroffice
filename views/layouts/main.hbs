<!DOCTYPE html>
<html lang="en">
<head>
  {{> seo-head}}
  <link rel="icon" type="image/png" sizes="128x128" href="{{asset '/images/favicon.png'}}">
  <link rel="apple-touch-icon" href="{{asset '/images/favicon.png'}}">
  <link rel="stylesheet" href="{{asset '/css/tokens.css'}}">
  <link rel="stylesheet" href="{{asset '/css/main.css'}}">
  {{#if meta.pageCss}}<link rel="stylesheet" href="{{asset (concat '/css/pages/' meta.pageCss '.css')}}">{{/if}}
</head>
<body{{#if (eq meta.pageCss 'home')}} class="has-dark-hero"{{/if}}>
  <a class="skip-link" href="#main">Skip to content</a>
  <span id="headerTopMark" class="header-top-mark" aria-hidden="true"></span>
  <header class="header" id="header">
    <div class="nav-backdrop" id="navBackdrop" aria-hidden="true"></div>
    <div class="nav-sheet" id="navSheet" aria-hidden="true">
      <div class="work-menu" id="workMenu" role="region" aria-label="Work" aria-hidden="true">
        <div class="work-menu-inner" id="workMenuInner">
          {{#each navWorkFeatured}}
          <a class="work-menu-card" href="/work/{{slug}}" style="--i:{{@index}}">
            <span class="work-menu-card-face">
              <span class="work-menu-card-arrow" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              {{#if image}}
              <span class="work-menu-card-media">
                <img src="{{asset image}}" alt="" width="560" height="560" loading="lazy">
              </span>
              {{/if}}
              <span class="work-menu-card-copy">
                <span class="work-menu-title">{{name}}</span>
                <span class="work-menu-kicker">{{tag}}</span>
                <span class="work-menu-go">View case</span>
              </span>
            </span>
          </a>
          {{/each}}
          <nav class="work-menu-side" aria-labelledby="workMenuSideTitle">
            <p class="work-menu-side-title work-menu-text" id="workMenuSideTitle" style="--i:0">Selected work</p>
            <ul>
              {{#each navWorkMore}}
              <li class="work-menu-text" style="--i:{{@index}}"><a href="/work/{{slug}}">{{name}}</a></li>
              {{/each}}
            </ul>
            <a class="work-menu-all work-menu-text" href="/work" style="--i:3">View all work
              <span class="work-menu-all-arw" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          </nav>
        </div>
      </div>
    </div>
    <div class="header-bar" id="headerBar">
      <a href="/" class="brand">{{> logo}}</a>
      <nav class="nav" aria-label="Primary">
        <div class="nav-links" id="navLinks">
          <span class="nav-pill" id="navPill" aria-hidden="true"></span>
          <ul>
            <li class="nav-item nav-item--work" id="navWorkItem">
              <a href="/work" id="navWorkLink" aria-haspopup="true" aria-expanded="false" aria-controls="workMenu" {{#if (eq meta.nav 'work')}}aria-current="page"{{/if}}>Work</a>
            </li>
            <li><a href="/capabilities" {{#if (eq meta.nav 'capabilities')}}aria-current="page"{{/if}}>Capabilities</a></li>
            <li><a href="/studio" {{#if (eq meta.nav 'studio')}}aria-current="page"{{/if}}>Studio</a></li>
            <li><a href="/insights" {{#if (eq meta.nav 'insights')}}aria-current="page"{{/if}}>Insights</a></li>
          </ul>
        </div>
      </nav>
      <div class="nav-end">
        <a href="/contact/start-a-project" class="btn-header">Talk to us
          <span class="btn-header-arw" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
        <button class="menu-toggle" id="menuToggle" type="button" aria-expanded="false" aria-controls="mobileMenu" aria-label="Open menu">
          <span class="menu-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
      </div>
    </div>
  </header>
  <script>
    (function () {
      var h = document.getElementById('header');
      if (h && window.scrollY > 1) {
        h.classList.add('is-sticky', 'is-compact');
      }
    })();
  </script>
  {{> mobile-menu}}
  <main id="main">
    {{{body}}}
  </main>
  <footer class="footer">
    <div class="foot-inner">
      <div class="foot-top">
        <h2>DO NOW</h2>
        <p>Let's figure out what to build. From Colombo, for thirty years.</p>
        <a href="/contact/start-a-project" class="foot-cta">Start a Project
          <span aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M5 15L15 5M15 5H7.5M15 5V12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </div>
      <div class="foot-grid">
        <div class="foot-col">
          <h3>Navigate</h3>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/work">Work</a></li>
            <li><a href="/capabilities">Capabilities</a></li>
            <li><a href="/studio">Studio</a></li>
            <li><a href="/insights">Insights</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div class="foot-col">
          <h3>Work</h3>
          <ul>
            <li><a href="/work/sinhala-tamil-ocr">Sinhala &amp; Tamil OCR</a></li>
            <li><a href="/work/asklex-law">AskLex.law</a></li>
            <li><a href="/work/financial-platform-engineering">Financial Platforms</a></li>
            <li><a href="/work/ai-agent-systems">AI Agent Systems</a></li>
            <li><a href="/work/data-protection">Data Protection</a></li>
            <li><a href="/work/product-engineering">Product Engineering</a></li>
          </ul>
        </div>
        <div class="foot-col">
          <h3>Studio</h3>
          <ul>
            <li><a href="/studio">About</a></li>
            <li><a href="/studio/approach">Approach</a></li>
            <li><a href="/studio/team">Team</a></li>
            <li><a href="/studio/careers">Careers</a></li>
            <li><a href="/insights">Insights</a></li>
          </ul>
        </div>
        <div class="foot-col">
          <h3>Contact</h3>
          <ul>
            <li><a href="mailto:hello@developeroffice.com">hello@developeroffice.com</a></li>
            <li><a href="tel:+94777552555">+94 77 755 2555</a></li>
            <li><a href="https://maps.google.com/?q=Nugegoda,Colombo">Nugegoda, Colombo</a></li>
            <li><a href="/contact/start-a-project">Start a Project</a></li>
            <li><a href="/contact/general-enquiries">General enquiries</a></li>
          </ul>
        </div>
      </div>
      <div class="foot-bottom">
        <a href="/" class="fb-logo">{{> logo invert=true}}</a>
        <p>&copy;{{year}} Developer Office. All rights reserved.</p>
        <span class="links"><a href="/privacy">Privacy</a><a href="/terms">Terms</a></span>
      </div>
    </div>
  </footer>
  {{> site-contact}}
  {{> action-bar}}
  <script defer src="{{asset '/js/header.js'}}"></script>
  <script defer src="{{asset '/js/reveal.js'}}"></script>
  <script defer src="{{asset '/js/count.js'}}"></script>
  <script defer src="{{asset '/js/method.js'}}"></script>
  <script defer src="{{asset '/js/contact-parallax.js'}}"></script>
  {{#if (eq meta.pageCss 'home')}}<script defer src="{{asset '/js/hero-bg.js'}}"></script>{{/if}}
  {{#if (eq meta.pageCss 'home')}}<script defer src="{{asset '/js/hero-shape.js'}}"></script>{{/if}}
  {{#if (eq meta.pageCss 'home')}}<script defer src="{{asset '/js/opening.js'}}"></script>{{/if}}
  {{#if (eq meta.pageCss 'home')}}<script defer src="{{asset '/js/work-facts.js'}}"></script>{{/if}}
  {{#if (eq meta.pageCss 'home')}}<script defer src="{{asset '/js/proof.js'}}"></script>{{/if}}
  {{#if (eq meta.pageCss 'home')}}<script defer src="{{asset '/js/ai-slider.js'}}"></script>{{/if}}
</body>
</html>
